# Vite auto-loads .env.test for `vitest`/test mode. Map.test.jsx mocks
# react-map-gl entirely, so this token is never sent anywhere — it only
# needs to be truthy so Map.jsx doesn't render its "set the key" fallback
# and hide the fullscreen button the tests assert on.
VITE_MAPBOX_KEY=test-vitest-token
